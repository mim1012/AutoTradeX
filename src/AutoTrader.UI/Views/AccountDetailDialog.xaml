<Window x:Class="AutoTrader.UI.Views.AccountDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoTrader.UI.Views"
        xmlns:vm="clr-namespace:AutoTrader.UI.ViewModels"
        mc:Ignorable="d"
        Title="계좌 상세 정보"
        Height="600" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="CanResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================
             타이틀
        ========================================= -->
        <TextBlock Grid.Row="0" 
                   Text="📝 계좌 상세 정보" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- ========================================
             기본 정보
        ========================================= -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20"
                Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 타이틀 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="기본 정보" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,0,0,15"/>

                <!-- 계좌번호 -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="계좌번호:" 
                           FontSize="14" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding AccountNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         Height="30"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,10"/>

                <!-- 계좌 별칭 -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="계좌 별칭:" 
                           FontSize="14" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding AccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         Height="30"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ========================================
             API 인증 정보
        ========================================= -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20"
                Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 타이틀 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="API 인증 정보" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,0,0,15"/>

                <!-- AppKey -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="AppKey:"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         x:Name="AppKeyTextBox"
                         Text="{Binding AppKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,10"/>
                <Button Grid.Row="1" Grid.Column="2"
                        Content="표시"
                        Width="60"
                        Height="30"
                        Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Margin="0,0,0,10"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Command="{Binding ToggleAppKeyVisibilityCommand}"/>

                <!-- AppSecret -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="AppSecret:"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                         x:Name="AppSecretTextBox"
                         Text="{Binding AppSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,10"/>
                <Button Grid.Row="2" Grid.Column="2"
                        Content="표시"
                        Width="60"
                        Height="30"
                        Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Margin="0,0,0,10"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Command="{Binding ToggleAppSecretVisibilityCommand}"/>

                <!-- API 연결 테스트 버튼 -->
                <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                        Content="API 연결 테스트" 
                        Width="150" 
                        Height="35"
                        Background="#2196F3"
                        Foreground="White"
                        FontWeight="Bold"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,10"
                        Cursor="Hand"
                        Command="{Binding TestApiConnectionCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5" 
                                                Padding="10,5">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 상태 메시지 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="{Binding ApiTestStatus}" 
                           FontSize="14" 
                           Foreground="{Binding ApiTestStatusColor}"
                           FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- ========================================
             매매 설정
        ========================================= -->
        <Border Grid.Row="3" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20"
                Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 타이틀 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="매매 설정" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,0,0,15"/>

                <!-- 매수 비율 -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="매수 비율:" 
                           FontSize="14" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <StackPanel Grid.Row="1" Grid.Column="1" 
                            Orientation="Horizontal"
                            Margin="0,0,0,10">
                    <TextBox Text="{Binding BuyRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Width="100"
                             Height="30"
                             VerticalContentAlignment="Center"
                             Margin="0,0,5,0"/>
                    <TextBlock Text="%" 
                               FontSize="14" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 관심종목 제외 -->
                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="관심종목 제외 (보유 종목은 조건 맞아도 매수 안함)" 
                          IsChecked="{Binding ExcludeOwnedStocks, Mode=TwoWay}"
                          FontSize="14"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ========================================
             하단 버튼
        ========================================= -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="저장" 
                    Width="100" 
                    Height="35"
                    Background="#2196F3"
                    Foreground="White"
                    FontWeight="Bold"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Command="{Binding SaveCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="5" 
                                            Padding="10,5">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="취소" 
                    Width="100" 
                    Height="35"
                    Background="#E0E0E0"
                    Foreground="Black"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Command="{Binding CancelCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="5" 
                                            Padding="10,5">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
