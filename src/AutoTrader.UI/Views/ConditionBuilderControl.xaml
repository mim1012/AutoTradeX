<UserControl x:Class="AutoTrader.UI.Views.ConditionBuilderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoTrader.UI.Views"
             xmlns:vm="clr-namespace:AutoTrader.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.Resources>
        <!-- 조건 항목 스타일 -->
        <Style x:Key="ConditionItemStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        
        <!-- 체크박스 스타일 -->
        <Style x:Key="ConditionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,2,8,0"/>
        </Style>
        
        <!-- 조건 ID 스타일 -->
        <Style x:Key="ConditionIdStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        
        <!-- 조건 설명 스타일 -->
        <Style x:Key="ConditionDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        
        <!-- 상태 메시지 스타일 -->
        <Style x:Key="StatusMessageStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        
        <!-- 버튼 스타일 -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 헤더 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="16">
            <TextBlock Text="📋 조건식 설정" FontSize="18" FontWeight="Bold"/>
        </Border>
        
        <!-- 조건 목록 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <!-- 조건 목록 헤더 -->
                <TextBlock Text="조건 목록 (최대 3개)" FontWeight="Bold" Margin="0,0,0,12"/>
                
                <!-- 조건 항목들 -->
                <ItemsControl ItemsSource="{Binding Conditions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ConditionItemStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- 첫 번째 줄: 체크박스 + ID + 설명 -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsEnabled}" 
                                                  Style="{StaticResource ConditionCheckBoxStyle}"/>
                                        <TextBlock Text="{Binding Id}" 
                                                   Style="{StaticResource ConditionIdStyle}"/>
                                        <TextBlock Text="{Binding Description}" 
                                                   Style="{StaticResource ConditionDescriptionStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    
                                    <!-- 두 번째 줄: 상태 메시지 -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,4,0,0">
                                        <TextBlock Text="상태: " 
                                                   Style="{StaticResource StatusMessageStyle}"/>
                                        <TextBlock Text="{Binding StatusMessage}" 
                                                   Style="{StaticResource StatusMessageStyle}"/>
                                    </StackPanel>
                                    
                                    <!-- 세 번째 줄: 편집/삭제 버튼 -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="24,8,0,0">
                                        <Button Content="편집" 
                                                Style="{StaticResource SmallButtonStyle}"
                                                Command="{Binding DataContext.EditConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="삭제" 
                                                Style="{StaticResource SmallButtonStyle}"
                                                Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- 조건 추가 버튼 -->
                <Button Content="+ 조건 추가" 
                        Command="{Binding AddConditionCommand}"
                        Padding="12,8"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1976D2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#BDBDBD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </ScrollViewer>
        
        <!-- 조건식 조합 영역 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,1" Padding="16">
            <StackPanel>
                <TextBlock Text="🔗 조건식 조합" FontWeight="Bold" Margin="0,0,0,12"/>

                <!-- 논리 연산자 선택 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="논리 연산자: " VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="AndRadioButton"
                                 Content="AND (모두 충족)"
                                 GroupName="LogicOperator"
                                 Margin="0,0,16,0"
                                 VerticalAlignment="Center"
                                 Checked="AndRadioButton_Checked"/>
                    <RadioButton x:Name="OrRadioButton"
                                 Content="OR (하나 이상 충족)"
                                 GroupName="LogicOperator"
                                 VerticalAlignment="Center"
                                 Checked="OrRadioButton_Checked"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="조건식: " VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding LogicExpression}"
                               FontWeight="Bold"
                               FontSize="16"
                               VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="💡 설명: " VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding LogicExplanation}"
                               TextWrapping="Wrap"
                               Foreground="#666"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- 하단 버튼 -->
        <Border Grid.Row="3" Background="White" Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="조건식 저장" 
                        Command="{Binding SaveConditionsCommand}"
                        Padding="16,8"
                        Margin="0,0,8,0"/>
                <Button Content="테스트 실행" 
                        Command="{Binding TestConditionsCommand}"
                        Padding="16,8"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#388E3C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
