<Window x:Class="AutoTrader.UI.Views.ConditionSetEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="⚙️ 조건식 설정"
        Height="900" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="CanResize">
    
    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 헤더 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="⚙️ 조건식 설정" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- 현재 활성 계좌 -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="8" 
                Padding="16"
                Margin="0,0,0,16"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="현재 활성 계좌" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Foreground="#666"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="ActiveAccountTextBlock"
                           Text="87654321-01 (서브 계좌)" 
                           FontSize="16" 
                           FontWeight="Bold"/>
            </StackPanel>
        </Border>
        
        <!-- 조건 목록 (테이블) -->
        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="8" 
                Padding="16"
                Margin="0,0,0,16"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" 
                           Text="📋 조건 목록" 
                           Style="{StaticResource SectionHeaderStyle}"/>
                
                <DataGrid Grid.Row="1"
                          x:Name="ConditionsDataGrid"
                          ItemsSource="{Binding Conditions}"
                          Style="{StaticResource DataGridStyle}"
                          Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="✓"
                                                Binding="{Binding IsEnabled}"
                                                Width="40"/>
                        <DataGridTemplateColumn Header="ID" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ConditionId}"
                                            Width="35"
                                            Height="25"
                                            Background="#2196F3"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="AddConditionIdToFormulaButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="조건 내용" 
                                            Binding="{Binding Description}" 
                                            Width="*" 
                                            IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="삭제" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="X"
                                            Width="30"
                                            Height="30"
                                            Background="#F44336"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="DeleteConditionButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                
                <Button Grid.Row="2" 
                        Content="+ 조건 추가" 
                        Width="120" 
                        Height="36"
                        HorizontalAlignment="Left"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        Click="AddConditionButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="16,8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#45A049"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
        
        <!-- 조건식 편집기 -->
        <Border Grid.Row="3" 
                Background="White" 
                CornerRadius="8" 
                Padding="16"
                Margin="0,0,0,16"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" 
                           Text="🔧 조건식 편집기" 
                           Style="{StaticResource SectionHeaderStyle}"/>
                
                <WrapPanel Grid.Row="1" 
                           x:Name="FormulaEditorPanel"
                           Margin="0,0,0,12">
                    <!-- 조건 ID 버튼들이 동적으로 추가됨 -->
                </WrapPanel>
                
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBlock Text="💡 조건 ID를 클릭하여 추가/제거, 드롭다운으로 AND/OR 선택" 
                               FontSize="12" 
                               Foreground="#666"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Button Content="( 괄호" 
                            Width="60" 
                            Height="28"
                            Margin="0,0,4,0"
                            Click="AddOpenParenButton_Click"/>
                    <Button Content=") 괄호" 
                            Width="60" 
                            Height="28"
                            Margin="0,0,4,0"
                            Click="AddCloseParenButton_Click"/>
                    <Button Content="⊗ 삭제" 
                            Width="60" 
                            Height="28"
                            Margin="0,0,4,0"
                            Click="RemoveLastTokenButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 조건식 미리보기 -->
        <Border Grid.Row="4" 
                Background="White" 
                CornerRadius="8" 
                Padding="16"
                Margin="0,0,0,16"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" 
                           Text="📝 조건식 미리보기" 
                           Style="{StaticResource SectionHeaderStyle}"/>
                
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:Name="FormulaPreviewTextBlock"
                               Text="조건식이 여기에 표시됩니다" 
                               FontSize="14" 
                               FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Foreground="#666"/>
                </ScrollViewer>
            </Grid>
        </Border>
        
        <!-- 조건 충족 종목 미리보기 -->
        <Border Grid.Row="5" 
                Background="#FFF3E0" 
                CornerRadius="8" 
                Padding="12"
                Margin="0,0,0,16">
            <TextBlock Text="💡 조건식을 수정하면 실시간으로 충족 종목이 업데이트됩니다." 
                       FontSize="12" 
                       Foreground="#F57C00"/>
        </Border>
        
        <Border Grid.Row="6" 
                Background="White" 
                CornerRadius="8" 
                Padding="16"
                Margin="0,0,0,16"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" 
                           Text="🎯 조건 충족 종목 미리보기 (실시간)" 
                           Style="{StaticResource SectionHeaderStyle}"/>
                
                <DataGrid Grid.Row="1"
                          x:Name="MatchedStocksDataGrid"
                          ItemsSource="{Binding MatchedStocks}"
                          Style="{StaticResource DataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="순위" 
                                            Binding="{Binding Rank}" 
                                            Width="60"/>
                        <DataGridTextColumn Header="종목코드" 
                                            Binding="{Binding Symbol}" 
                                            Width="100"/>
                        <DataGridTextColumn Header="종목명" 
                                            Binding="{Binding Name}" 
                                            Width="*"/>
                        <DataGridTextColumn Header="현재가" 
                                            Binding="{Binding CurrentPrice, StringFormat={}{0:C}}" 
                                            Width="100"/>
                        <DataGridTextColumn Header="등락률" 
                                            Binding="{Binding ChangePercent, StringFormat={}{0:F2}%}" 
                                            Width="80"/>
                        <DataGridTextColumn Header="거래대금" 
                                            Binding="{Binding TradeVolume, StringFormat={}{0:C0}}" 
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        
        <!-- 하단 버튼 -->
        <StackPanel Grid.Row="7" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,0,0,0">
            <Button Content="취소" 
                    Width="100" 
                    Height="40" 
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>
            <Button Content="저장" 
                    Width="100" 
                    Height="40"
                    Background="#2196F3"
                    Foreground="White"
                    BorderThickness="0"
                    Click="SaveButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="16,8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
