<Window x:Class="AutoTrader.UI.Views.MainDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoTrader.UI.Views"
        xmlns:vm="clr-namespace:AutoTrader.UI.ViewModels"
        xmlns:converters="clr-namespace:AutoTrader.UI.Converters"
        mc:Ignorable="d"
        Title="AutoTradeX - 해외주식 자동매매 시스템"
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <converters:IsNegativeConverter x:Key="IsNegativeConverter"/>
        <converters:IsPositiveConverter x:Key="IsPositiveConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 시스템 상태 -->
            <RowDefinition Height="*"/>
            <!-- 거래대금 상위 300 종목 -->
            <RowDefinition Height="Auto"/>
            <!-- 조건 충족 종목 -->
            <RowDefinition Height="200"/>
            <!-- 시스템 로그 -->
        </Grid.RowDefinitions>

        <!-- ========================================
             시스템 상태 영역
        ========================================= -->
        <Border Grid.Row="0" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20"
                Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 타이틀 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="📊 시스템 상태" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Margin="0,0,0,15"/>

                <!-- 현재 활성 계좌 -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="현재 활성 계좌:" 
                           FontSize="14" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding ActiveAccountDisplay}" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#2196F3"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <Button Grid.Row="1" Grid.Column="2"
                        Content="계좌 변경" 
                        Width="100" 
                        Height="30"
                        Background="White"
                        BorderBrush="#2196F3"
                        BorderThickness="1"
                        Foreground="#2196F3"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Margin="0,0,0,10"
                        Command="{Binding OpenAccountManagementCommand}"/>

                <!-- 조건식 -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="조건식:" 
                           FontSize="14" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding ConditionSetDisplay}" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#2196F3"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <Button Grid.Row="2" Grid.Column="2"
                        Content="조건식 편집" 
                        Width="100" 
                        Height="30"
                        Background="White"
                        BorderBrush="#2196F3"
                        BorderThickness="1"
                        Foreground="#2196F3"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Margin="0,0,0,10"
                        Command="{Binding OpenConditionEditorCommand}"/>

                <!-- 시스템 상태 및 시작/중지 버튼 -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" 
                            Orientation="Horizontal" 
                            Margin="0,15,0,0">
                    <TextBlock Text="시스템 상태:" 
                               FontSize="14" 
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Ellipse Width="12" Height="12" 
                             Fill="{Binding SystemStatusColor}" 
                             VerticalAlignment="Center"
                             Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding SystemStatusText}" 
                               FontSize="14" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>

                    <Button Content="{Binding StartStopButtonText}" 
                            Width="150" 
                            Height="40"
                            Background="{Binding StartStopButtonBackground}"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Command="{Binding ToggleSystemCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5" 
                                                    Padding="10,5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="{Binding LastUpdateTime}" 
                               FontSize="12" 
                               Foreground="#757575"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================
             거래대금 상위 300 종목
        ========================================= -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20"
                Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 타이틀 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="📈 거래대금 상위 300 종목" 
                               FontSize="18" 
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Top300StocksCount}" 
                               FontSize="14" 
                               Foreground="#757575"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding Top300Stocks}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          AlternatingRowBackground="#F9F9F9"
                          Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="순위" Binding="{Binding Rank}" Width="60"/>
                        <DataGridTextColumn Header="종목코드" Binding="{Binding Symbol}" Width="100"/>
                        <DataGridTextColumn Header="종목명" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="현재가" Binding="{Binding CurrentPrice, StringFormat=C2}" Width="120"/>
                        <DataGridTextColumn Header="등락률" Binding="{Binding ChangeRate, StringFormat=P2}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChangeRate, Converter={StaticResource IsNegativeConverter}}" Value="True">
                                            <Setter Property="Foreground" Value="#F44336"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ChangeRate, Converter={StaticResource IsPositiveConverter}}" Value="True">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="거래대금" Binding="{Binding TradeAmount, StringFormat=C0}" Width="150"/>
                        <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="✅">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ========================================
             조건 충족 종목
        ========================================= -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20"
                Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 타이틀 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="🎯 조건 충족 종목" 
                               FontSize="18" 
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding MatchedStocksCount}" 
                               FontSize="14" 
                               Foreground="#4CAF50"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding MatchedStocks}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          Background="White"
                          Height="150">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="순위" Binding="{Binding Rank}" Width="60"/>
                        <DataGridTextColumn Header="종목코드" Binding="{Binding Symbol}" Width="100"/>
                        <DataGridTextColumn Header="종목명" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="현재가" Binding="{Binding CurrentPrice, StringFormat=C2}" Width="120"/>
                        <DataGridTextColumn Header="등락률" Binding="{Binding ChangeRate, StringFormat=P2}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#F44336"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="확인" Binding="{Binding ConfirmCount}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConfirmCount}" Value="✅ 2">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConfirmCount}" Value="✅ 1">
                                            <Setter Property="Foreground" Value="#FF9800"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="주문" Binding="{Binding OrderStatus}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#2196F3"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ========================================
             시스템 로그
        ========================================= -->
        <Border Grid.Row="3" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 타이틀 -->
                <TextBlock Grid.Row="0" 
                           Text="📝 시스템 로그" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Margin="0,0,0,15"/>

                <!-- 로그 뷰어 -->
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto"
                              Background="#FAFAFA"
                              Padding="10">
                    <TextBlock Text="{Binding SystemLogs}" 
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </ScrollViewer>

                <!-- 버튼 -->
                <StackPanel Grid.Row="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0">
                    <Button Content="로그 저장" 
                            Width="100" 
                            Height="30"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            Command="{Binding SaveLogsCommand}"/>
                    <Button Content="로그 지우기" 
                            Width="100" 
                            Height="30"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            Cursor="Hand"
                            Command="{Binding ClearLogsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
