<Window x:Class="AutoTrader.UI.Views.ConditionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoTrader.UI.Views"
        mc:Ignorable="d"
        Title="조건 추가/편집" 
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource InputStyle}">
            <Setter Property="Height" Value="36"/>
        </Style>
        
        <Style x:Key="TextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
            <Setter Property="Height" Value="36"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 헤더 -->
        <TextBlock Grid.Row="0" 
                   Text="조건 설정" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>
        
        <!-- 메인 입력 영역 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 조건 타입 선택 -->
                <TextBlock Text="조건 타입" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="ConditionTypeComboBox"
                          Style="{StaticResource ComboBoxStyle}"
                          SelectionChanged="ConditionTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="A) 등락률 조건" Tag="PriceChange" ToolTip="전일 종가 대비 현재가 변동률 (%) - KIS API 제공"/>
                    <ComboBoxItem Content="B) 이동평균선 조건" Tag="MovingAverage"/>
                    <ComboBoxItem Content="C) 거래대금 조건" Tag="TradeVolume"/>
                    <ComboBoxItem Content="D) 주가 비교 조건" Tag="PriceComparison"/>
                </ComboBox>
                
                <!-- 동적 입력 폼 컨테이너 -->
                <Border x:Name="DynamicFormContainer" 
                        Background="White" 
                        CornerRadius="8" 
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel x:Name="DynamicFormPanel">
                        <TextBlock Text="조건 타입을 선택하세요" 
                                   Foreground="#999" 
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,40,0,40"/>
                    </StackPanel>
                </Border>
                
                <!-- 미리보기 -->
                <TextBlock Text="조건 미리보기" Style="{StaticResource LabelStyle}"/>
                <Border Background="White" 
                        CornerRadius="8" 
                        Padding="16"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">
                    <TextBlock x:Name="PreviewTextBlock" 
                               Text="조건을 설정하면 여기에 표시됩니다" 
                               TextWrapping="Wrap"
                               Foreground="#666"
                               FontSize="14"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- 하단 버튼 -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="취소" 
                    Width="100" 
                    Height="40" 
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>
            <Button x:Name="SaveButton"
                    Content="저장" 
                    Width="100" 
                    Height="40"
                    Background="#2196F3"
                    Foreground="White"
                    BorderThickness="0"
                    Click="SaveButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="16,8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
