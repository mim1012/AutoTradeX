<Window x:Class="AutoTrader.UI.Views.AccountManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoTrader.UI.Views"
        xmlns:vm="clr-namespace:AutoTrader.UI.ViewModels"
        mc:Ignorable="d"
        Title="계좌 관리" 
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================
             타이틀
        ========================================= -->
        <TextBlock Grid.Row="0" 
                   Text="💼 계좌 관리" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- ========================================
             등록된 계좌 목록
        ========================================= -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 타이틀 -->
                <TextBlock Grid.Row="0" 
                           Text="등록된 계좌 목록" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,0,0,15"/>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount}"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          AlternatingRowBackground="#F9F9F9"
                          Background="White">
                    <DataGrid.Columns>
                        <!-- 활성 (라디오 버튼) -->
                        <DataGridTemplateColumn Header="활성" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <RadioButton IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 GroupName="ActiveAccount"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Command="{Binding DataContext.SetActiveAccountCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                 CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 계좌번호 -->
                        <DataGridTextColumn Header="계좌번호" Binding="{Binding AccountNumber}" Width="150"/>

                        <!-- 별칭 -->
                        <DataGridTextColumn Header="별칭" Binding="{Binding AccountName}" Width="*"/>

                        <!-- 조건식 -->
                        <DataGridTextColumn Header="조건식" Binding="{Binding ConditionSetStatus}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConditionSetStatus}" Value="✅ 설정">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConditionSetStatus}" Value="❌ 미설정">
                                            <Setter Property="Foreground" Value="#F44336"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 작업 버튼 -->
                        <DataGridTemplateColumn Header="작업" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="편집" 
                                                Width="60" 
                                                Height="25"
                                                Background="White"
                                                BorderBrush="#2196F3"
                                                BorderThickness="1"
                                                Foreground="#2196F3"
                                                FontSize="12"
                                                Margin="0,0,5,0"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="삭제" 
                                                Width="60" 
                                                Height="25"
                                                Background="White"
                                                BorderBrush="#F44336"
                                                BorderThickness="1"
                                                Foreground="#F44336"
                                                FontSize="12"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 안내 메시지 -->
                <TextBlock Grid.Row="2" 
                           Text="💡 활성 계좌는 최대 1개만 선택 가능합니다." 
                           FontSize="12" 
                           Foreground="#757575"
                           Margin="0,15,0,0"/>

                <!-- 계좌 추가 버튼 -->
                <Button Grid.Row="3" 
                        Content="+ 계좌 추가" 
                        Width="120" 
                        Height="35"
                        Background="#2196F3"
                        Foreground="White"
                        FontWeight="Bold"
                        HorizontalAlignment="Left"
                        Margin="0,15,0,0"
                        Cursor="Hand"
                        Command="{Binding AddAccountCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5" 
                                                Padding="10,5">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ========================================
             하단 버튼
        ========================================= -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="확인" 
                    Width="100" 
                    Height="35"
                    Background="#2196F3"
                    Foreground="White"
                    FontWeight="Bold"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Command="{Binding ConfirmCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="5" 
                                            Padding="10,5">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="취소" 
                    Width="100" 
                    Height="35"
                    Background="#E0E0E0"
                    Foreground="Black"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Command="{Binding CancelCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="5" 
                                            Padding="10,5">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
